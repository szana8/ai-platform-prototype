                "list": false,
                "show": true,
                "multiline": true,
                "value": "# from langflow.field_typing import Data\nfrom langflow.custom import Component\nfrom langflow.io import MessageTextInput, Output\nfrom langflow.schema import Data\n\nfrom langfuse import Langfuse\nfrom langfuse.callback import CallbackHandler\n\n\nclass CustomComponent(Component):\n    display_name = \"Langfuse Prompt Component\"\n    description = \"Use as a template to create your own component.\"\n    documentation: str = \"https://docs.langflow.org/components-custom-components\"\n    icon = \"langfuse\"\n    name = \"LangfusePropmpComponent\"\n\n    inputs = [\n        MessageTextInput(\n            name=\"prompt_name\",\n            display_name=\"Prompt Name\",\n            info=\"Languse Prompt Name\",\n        ),\n        MessageTextInput(\n            name=\"host\",\n            display_name=\"Langfuse Host\",\n            info=\"Languse Host\",\n        ),\n        MessageTextInput(\n            name=\"public_key\",\n            display_name=\"Langfuse Public Key\",\n            info=\"Languse Public Key\",\n        ),\n        MessageTextInput(\n            name=\"secret_key\",\n            display_name=\"Langfuse Secret Key\",\n            info=\"Languse Secret Key\",\n        ),\n    ]\n        \n        \n\n    outputs = [\n        Output(display_name=\"Output\", name=\"output\", method=\"build_output\"),\n    ]\n\n    def build_output(self) -> Message:\n        langfuse_config = {\n            'public_key': self.public_key,\n            'secret_key': self.secret_key,\n            'host': self.host\n        }\n        \n        \n        langfuse_handler = CallbackHandler(**langfuse_config)\n        langfuse = Langfuse(**langfuse_config)\n        \n        prompt = langfuse.get_prompt(self.prompt_name)\n        \n        message = Message(\n            text=prompt.prompt,\n        )\n        self.status = prompt.prompt\n        return message\n",
